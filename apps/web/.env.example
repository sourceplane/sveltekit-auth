# Local secrets, upstream's .env.example: copy to .env (git-ignored), which
# `vite dev` and `wrangler dev` both read, or run
# `pnpm --filter @app/web secret:dev`, which writes a generated AUTH_SECRET
# into .env and keeps it on a second run. (A .dev.vars file, if there is one,
# takes the place of .env for wrangler.) Nothing here is read at build time:
# deployed, the Worker reads every value at request time from its own
# secrets, which the deploy lane pushes.
#
# Required: the key Auth.js encrypts its session cookie with. Any long random
# string; on UNIX systems `openssl rand -hex 32`.
AUTH_SECRET=

# Optional: a sign-in provider appears on /signin once all its keys are set.
# These are the nine providers upstream's .env.example names; every other
# provider's keys are in src/server/providers.ts.
# GitHub: https://github.com/settings/developers → New OAuth App, callback
# http://localhost:3000/auth/callback/github (and your deployed origin's).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_LINKEDIN_ID=
AUTH_LINKEDIN_SECRET=
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=
AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=
AUTH_PINTEREST_ID=
AUTH_PINTEREST_SECRET=
AUTH_AUTH0_ID=
AUTH_AUTH0_SECRET=
AUTH_AUTH0_ISSUER=
