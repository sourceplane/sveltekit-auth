{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "description": "Auth.js's SvelteKit example on Cloudflare Workers + Static Assets",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "wrangler dev --config wrangler.jsonc",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "secret:dev": "node ../../tooling/wire/worker-secrets.mjs --dev-vars .env --generate AUTH_SECRET --secret AUTH_SECRET"
  },
  "dependencies": {
    "@auth/sveltekit": "1.11.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.60.1",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/node": "^22.20.5",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "5.55.7",
    "svelte-check": "^4.3.1",
    "typescript": "^5.8.3",
    "vite": "6.4.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.151.0"
  }
}
